<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dinov3_nav</name>
  <version>0.1.0</version>
  <description>DINOv3 traversable-ground segmentation as a ROS 2 node: subscribes to a front camera image, publishes ground masks, and drives the base via cmd_vel.</description>
  <maintainer email="dow@todo.todo">dow</maintainer>
  <license>MIT</license>

  <!-- torch / ground_seg 依赖在仓库 .venv 里，不经 rosdep 管理；这里只声明 ROS 侧依赖 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
